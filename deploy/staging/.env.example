APP_HOST=staging-dailycheck.example.com
APP_ORIGIN=https://staging-dailycheck.example.com
STORAGE_HOST=storage-staging-dailycheck.example.com
S3_PUBLIC_ENDPOINT=https://storage-staging-dailycheck.example.com

POSTGRES_DB=dailycheck_staging
POSTGRES_USER=dailycheck_app
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
# URL-encode the password in DATABASE_URL when it contains reserved URL characters.
DATABASE_URL=postgresql://dailycheck_app:replace-with-a-url-encoded-password@postgres:5432/dailycheck_staging

JWT_SECRET=replace-with-a-long-random-secret

MINIO_ROOT_USER=replace-with-a-strong-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
S3_REGION=us-east-1
# Dedicated application credentials. Do not reuse the MinIO root credentials.
S3_ACCESS_KEY=replace-with-the-minio-access-key
S3_SECRET_KEY=replace-with-the-minio-secret-key
S3_BUCKET_NAME=dailycheck-photos-staging

# Approved pinned MinIO AIStor Free image. Do not use latest.
MINIO_SERVER_IMAGE=quay.io/minio/aistor/minio@sha256:17527b97a9e92dcc32b641dc161e4beb1eaf9a9198018c1489923c981f4af2ef
MINIO_CLIENT_IMAGE=quay.io/minio/aistor/minio@sha256:17527b97a9e92dcc32b641dc161e4beb1eaf9a9198018c1489923c981f4af2ef
