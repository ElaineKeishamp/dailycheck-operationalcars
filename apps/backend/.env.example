# Port API lokal.
PORT=3000

# Database khusus DailyCheck. Ganti user, password, dan nama database.
# Encode karakter khusus pada password sebagai bagian URL.
DATABASE_URL=postgresql://dailycheck_app:GANTI_PASSWORD@127.0.0.1:5432/dailycheck

# Isi dengan kunci acak yang panjang. Jangan gunakan nilai contoh untuk deployment.
JWT_SECRET=GANTI_DENGAN_KUNCI_ACAK

# Kosong untuk akses langsung. Untuk reverse proxy, isi IP/CIDR yang dipercaya.
TRUST_PROXY=

# Contoh storage lokal. Untuk Deka BOX, ganti ketiganya dengan endpoint dari tim IT.
# S3_PUBLIC_ENDPOINT adalah alamat yang dijangkau browser; bucket tetap privat.
S3_ENDPOINT=http://127.0.0.1:9000
S3_INTERNAL_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000

# Gunakan region signing dari penyedia. Nilai berikut hanya contoh server lokal.
S3_REGION=us-east-1
S3_ACCESS_KEY=GANTI_ACCESS_KEY_APLIKASI
S3_SECRET_KEY=GANTI_SECRET_KEY_APLIKASI
S3_BUCKET_NAME=dailycheck-photos
