PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/DATABASE
JWT_SECRET=replace-with-a-random-secret

S3_INTERNAL_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://storage-staging.example.com

# Legacy/local-development fallback. Prefer S3_INTERNAL_ENDPOINT and S3_PUBLIC_ENDPOINT.
# Leave empty in staging unless a single endpoint is intentionally used for both clients.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
S3_BUCKET_NAME=dailycheck-photos-staging
